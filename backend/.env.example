DB_HOST=localhost
DB_USER=root
DB_PW=
DB_NAME=speckit-db
AUTH_SECRET=change-me-in-production
# Base64-encoded 32-byte key for app/authentication/crypto.js
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_KEY=
PORT=3200
NODE_ENV=development
# In development, schema changes auto-apply on server start (set false to disable).
SEQUELIZE_SYNC_ALTER=true
